{
  "schemaVersion": 1,
  "id": "inventorysorter",
  "version": "${version}",
  "name": "InventorySorter",
  "description": "Adds one-click sort buttons and a keybind to player and container inventories (chest, shulker, ender chest, barrel). Sort by name, item type, creative category, or rarity, in horizontal, vertical, or grouped layouts.",
  "authors": [
    "Orchiwi"
  ],
  "contact": {
    "homepage": "https://github.com/Orchiwi/InventorySorter",
    "sources": "https://github.com/Orchiwi/InventorySorter",
    "issues": "https://github.com/Orchiwi/InventorySorter/issues"
  },
  "license": "MIT",
  "icon": "assets/inventorysorter/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "fr.horizonsmp.inventorysorter.client.InventorysorterDataGenerator"
    ],
    "client": [
      "fr.horizonsmp.inventorysorter.client.InventorysorterClient"
    ],
    "main": [
      "fr.horizonsmp.inventorysorter.Inventorysorter"
    ],
    "modmenu": [
      "fr.horizonsmp.inventorysorter.client.modmenu.ModMenuApiImpl"
    ]
  },
  "mixins": [
    "inventorysorter.mixins.json",
    {
      "config": "inventorysorter.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "modmenu": ">=15.0.0"
  }
}
